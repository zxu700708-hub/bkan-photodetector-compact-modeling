      surface_recombination = (0.04257352277636528)*net_softplus(-3.0355315208435059 + (-0.014385473914444447)*phi_0 + (0.051333032548427582)*phi_1 + (0.036047596484422684)*phi_3 + (0.51435816287994385)*phi_8 + (0.23247089982032776)*phi_17 + (0.0067121558822691441)*phi_22 + (-0.038931179791688919)*phi_27)*(net_sigmoid(4.0*reverse_zero));
      trap_recombination = (0.036041177809238434)*net_softplus(-3.0440239906311035 + (-0.031583406031131744)*phi_0 + (0.039414700120687485)*phi_1 + (-0.025164209306240082)*phi_4 + (0.033212203532457352)*phi_10 + (-0.015822052955627441)*phi_19 + (-0.036693606525659561)*phi_23)*(net_sigmoid(4.0*reverse_zero));
      residual = -0.067603632807731628 + (-0.093018084764480591)*phi_0 + (0.0058115636929869652)*phi_1 + (-0.0049644326791167259)*phi_2 + (0.00020143878646194935)*phi_3 + (0.0065452009439468384)*phi_4 + (-0.02372385561466217)*phi_5 + (-0.015203757211565971)*phi_6 + (0.0069154724478721619)*phi_7 + (0.0015629465924575925)*phi_8 + (0.042934298515319824)*phi_9 + (-0.020657788962125778)*phi_10 + (0.018768895417451859)*phi_11 + (-0.00068563030799850821)*phi_12 + (-0.001322719850577414)*phi_13 + (0.00059135298943147063)*phi_14 + (-0.0043415636755526066)*phi_15 + (0.0031439836602658033)*phi_16 + (-0.020888732746243477)*phi_17 + (-0.010461320169270039)*phi_18 + (-0.02332712896168232)*phi_19 + (0.0010256745154038072)*phi_20 + (0.024223349988460541)*phi_21 + (0.021021453663706779)*phi_22 + (-0.00022818251454737037)*phi_23 + (-0.0096869440749287605)*phi_24 + (-0.023290187120437622)*phi_25 + (0.0034513883292675018)*phi_26 + (-0.018460320308804512)*phi_27 + (-0.00039348227437585592)*phi_28;
      generic = 0;
      normalized_output = ((-1)*photogeneration + (-1)*field_collection)*exp(-net_clip08(surface_recombination))*exp(-net_clip08(trap_recombination)) + (0.0) + residual + generic;
      model_space_output = (3.3712586758532748)*normalized_output;
      net_photocurrent_model = pow(10.0, model_space_output);
    end
  endfunction
  // END NET_PHOTOCURRENT_FUNCTION
analog begin
    vd = V(anode, cathode);
    T = sim_temp;

    if (vd < v_min)
      vd_safe = v_min;
    else if (vd > v_max)
      vd_safe = v_max;
    else
      vd_safe = vd;

    // DC source: symbolic KAN formulas from artifacts/results/device_modeling/I-dark-bayes-results/symbolic_formula.txt and artifacts/results/device_modeling/I-photo-bayes-results/symbolic_formula.txt.
    dark_current = dark_boundary_gate(vd_safe) * smax0(pow(10, 0.0041364920460940603*T - 8979627246308360.0*sqr(6.6960677352389096e-10 - safe_exp_kan(-0.068282438309411303*T)) + 4.1655510196711703*sqr(-0.0037685927983991002*T + 1 + 0.35055107291988502/(2.7419450672245702 - 3.99278414053469*vd_safe)) + 11.091804671452*sqr(-0.0036384309408752299*T + 1 + 0.27795067599470802/(2.71809355668523 - 3.91344149021847*vd_safe)) - 4.0797652084980403*sqr(0.0031437998134108301*T - 1 - 0.129413223340552/(1.9810310906033299 - 4.2284055530582396*vd_safe)) - 10.890950950498899*sqr(0.0032060372831007001*T - 1 - 0.067104895549517998/(1.0388148580098799 - 1.47159079721493*vd_safe)) - 7.12316065714458*sqr(0.0032401308694073399*T - 1 - 0.152897530929964/(1.65810271741587 - 4.9512858805121001*vd_safe)) - 7.9153253720267003*sqr(0.0031007692729312099*T + 0.43802923045546699*sqr(1 - 0.027698242091027201*active_layer_length) - 1 - 0.25256010136551499/(2.3734751394050502 - 2.5912779117378402*vd_safe)) - 7.6048937528310399 - 0.146112698632896/(1.21672301165792 - 1.4259479623268201*vd_safe)), smooth_delta);
    photo_current = net_photocurrent_model(vd_safe, trap_assisted_recomb_A, ge_sio2_recomb_velocity, ge_si_recomb_velocity, active_layer_length, T);
    // photo_current is the dark-subtracted net photocurrent I_illum - I_dark.
    dc_current = area * (dark_current + light_power * photo_current);

    q_terminal = area * terminal_charge_model(vd_safe, trap_assisted_recomb_A, ge_sio2_recomb_velocity,
                                                     ge_si_recomb_velocity, active_layer_length, sim_temp);

    I(anode, cathode) <+ dc_current;
    I(anode, cathode) <+ ddt(q_terminal);
  end

endmodule
