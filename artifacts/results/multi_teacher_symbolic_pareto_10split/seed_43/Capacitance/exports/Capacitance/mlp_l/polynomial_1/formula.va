`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9355237474437262e-14
    + (2.2124636016372735e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.254342999368792e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (-2.0136072144448493e-18)*(((x2-9.9959359872406932e-10)/1.0098467482428761e-10))
    + (-8.9596420964720303e-19)*(((x3-2504.7787923322667)/101.89812212506544))
    + (-1.1614938868181992e-17)*(((x4-499.08853765450311)/18.608482583309684))
    + (1.3615799895434384e-15)*(((x5-40.083076418965781)/1.8998604612903924))
    + (1.0188587814551393e-16)*(((x6-299.49239846104678)/4.7705063480906693))
  ;
  V(out) <+ y;
end
endmodule
