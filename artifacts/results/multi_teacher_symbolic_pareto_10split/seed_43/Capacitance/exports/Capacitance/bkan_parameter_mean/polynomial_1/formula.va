`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9359613371620862e-14
    + (2.2263007805489259e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.186470699192518e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (6.2773809591767024e-19)*(((x2-9.9959359872406932e-10)/1.0098467482428761e-10))
    + (5.4769704074472305e-19)*(((x3-2504.7787923322667)/101.89812212506544))
    + (9.9240277397455779e-19)*(((x4-499.08853765450311)/18.608482583309684))
    + (1.3885796016286856e-15)*(((x5-40.083076418965781)/1.8998604612903924))
    + (9.200072687574044e-17)*(((x6-299.49239846104678)/4.7705063480906693))
  ;
  V(out) <+ y;
end
endmodule
