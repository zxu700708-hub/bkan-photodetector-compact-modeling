parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -6.5576925565034925
    + (-0.11210859923241412)*(((x0--1.6000000000000003)/0.86409875978771478))
    + (-0.0082109817645255809)*(((x1-1.0102087322789212e-09)/9.944872072671304e-11))
    + (0.013229935844893155)*(((x2-2504.1845870114798)/100.47393005004234))
    + (0.0001383215171179613)*(((x3-499.22935375644624)/16.506700355907874))
    + (0.019980097737266375)*(((x4-39.801426992738563)/1.8206850689722498))
    + (0.12283797210480102)*(((x5-299.2256329589672)/4.5373082381430416))
  ;
