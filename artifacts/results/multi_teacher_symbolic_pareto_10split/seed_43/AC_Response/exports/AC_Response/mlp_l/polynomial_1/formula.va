`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.30128671879788
    + (-2.2458819048911387)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.007461102172138633)*(((x1-39.875048270087852)/1.9456057043562431))
    + (0.0095549009048469056)*(((x2-299.44278519162845)/4.6926112259466697))
  ;
  V(out) <+ y;
end
endmodule
