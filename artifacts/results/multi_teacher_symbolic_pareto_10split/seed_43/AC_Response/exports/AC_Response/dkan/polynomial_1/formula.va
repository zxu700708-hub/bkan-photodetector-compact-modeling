`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3092557103833653
    + (-2.2495915880185864)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.012388996051582927)*(((x1-39.875048270087852)/1.9456057043562431))
    + (0.0099210856467391775)*(((x2-299.44278519162845)/4.6926112259466697))
  ;
  V(out) <+ y;
end
endmodule
