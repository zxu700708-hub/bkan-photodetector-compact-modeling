`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3039261935749549
    + (-2.242649491019336)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.006814932447210909)*(((x1-39.989303855892182)/1.9524236265085084))
    + (0.011322109718057291)*(((x2-299.83227080551274)/4.6920728487850187))
  ;
  V(out) <+ y;
end
endmodule
