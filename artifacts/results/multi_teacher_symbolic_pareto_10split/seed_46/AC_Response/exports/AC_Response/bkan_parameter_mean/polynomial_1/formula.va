`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3050047212822746
    + (-2.2500193988272299)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.014181440460669223)*(((x1-39.989303855892182)/1.9524236265085084))
    + (0.025177560984818281)*(((x2-299.83227080551274)/4.6920728487850187))
  ;
  V(out) <+ y;
end
endmodule
