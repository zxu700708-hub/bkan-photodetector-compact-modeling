`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // light_voltage
parameter real x1=0.0; // trap_assisted_recomb_A
parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -3.3042681596886654
    + (-0.020687739048971546)*(((x0--1.5)/0.92195444572928875))
    + (0.0012076305373312059)*(((x1-9.9084011893346887e-10)/9.5621631680259732e-11))
    + (-0.0022048584895166578)*(((x2-2500.8102995523814)/94.327894450129492))
    + (2.3983145550775365e-05)*(((x3-501.46209182799129)/18.877644032657962))
    + (0.004527123164368721)*(((x4-40.075139108703915)/1.9195546137588142))
    + (-0.0019064416893637111)*(((x5-299.52890716236504)/5.0181680096737731))
  ;
  V(out) <+ y;
end
endmodule
