`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3059077301534745
    + (-2.2501831955208127)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.014739389952753956)*(((x1-40.032487245505138)/1.967894180694129))
    + (0.028527328719186808)*(((x2-299.55241399998533)/4.4484154535657945))
  ;
  V(out) <+ y;
end
endmodule
