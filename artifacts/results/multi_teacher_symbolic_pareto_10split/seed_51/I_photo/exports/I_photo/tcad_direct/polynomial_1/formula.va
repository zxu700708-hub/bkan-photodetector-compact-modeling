`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // light_voltage
parameter real x1=0.0; // trap_assisted_recomb_A
parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -3.30513273587388
    + (-0.02083680000849442)*(((x0--1.5)/0.92195444572928875))
    + (0.00095341628875191811)*(((x1-1.0034379633002606e-09)/9.2418537079675437e-11))
    + (-0.0024355719698630016)*(((x2-2505.0963068600249)/94.395704098246284))
    + (-2.4652656470097494e-05)*(((x3-498.51488513995088)/18.830062937700614))
    + (0.0045177005056674137)*(((x4-39.825619825184226)/2.0263027502233051))
    + (-0.0013438392284095715)*(((x5-299.6092940137579)/4.8737660579238256))
  ;
  V(out) <+ y;
end
endmodule
