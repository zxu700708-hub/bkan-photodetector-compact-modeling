`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9291314180324961e-14
    + (2.2305051560976835e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.2084104927632012e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (-5.8875562729182456e-19)*(((x2-9.9786058034123165e-10)/9.9989354682098068e-11))
    + (4.2440249609910229e-19)*(((x3-2501.8920679372181)/101.68880690255412))
    + (-5.3986402371663816e-19)*(((x4-499.50061896561857)/18.213610629515429))
    + (1.4373588412707969e-15)*(((x5-39.989716366242313)/1.9619188824133635))
    + (1.0744528659052677e-16)*(((x6-299.524245533878)/4.725667830075496))
  ;
  V(out) <+ y;
end
endmodule
