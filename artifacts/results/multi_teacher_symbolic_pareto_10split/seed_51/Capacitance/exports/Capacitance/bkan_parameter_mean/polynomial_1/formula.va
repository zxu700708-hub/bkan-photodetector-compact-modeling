`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9298288300711276e-14
    + (2.2274889720731841e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.1006049620781883e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (3.9674960117137145e-19)*(((x2-9.9786058034123165e-10)/9.9989354682098068e-11))
    + (1.0749992531702098e-18)*(((x3-2501.8920679372181)/101.68880690255412))
    + (1.5275474592767194e-19)*(((x4-499.50061896561857)/18.213610629515429))
    + (1.4391846948583965e-15)*(((x5-39.989716366242313)/1.9619188824133635))
    + (9.6321828949892062e-17)*(((x6-299.524245533878)/4.725667830075496))
  ;
  V(out) <+ y;
end
endmodule
