`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.303886004897592
    + (-2.2499286974265362)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.0078936723457038484)*(((x1-40.287160832329242)/1.8202808655859122))
    + (0.021212692559361635)*(((x2-299.04781571945784)/4.634487294406803))
  ;
  V(out) <+ y;
end
endmodule
