`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3114378204630626
    + (-2.2599929505023244)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.014364239436674935)*(((x1-40.287160832329242)/1.8202808655859122))
    + (0.023067879646346517)*(((x2-299.04781571945784)/4.634487294406803))
  ;
  V(out) <+ y;
end
endmodule
