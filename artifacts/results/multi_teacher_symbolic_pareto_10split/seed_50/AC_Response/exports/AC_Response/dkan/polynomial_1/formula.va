`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3045602510427381
    + (-2.2486734412820937)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.0086023814622088884)*(((x1-40.287160832329242)/1.8202808655859122))
    + (0.0052683140561065496)*(((x2-299.04781571945784)/4.634487294406803))
  ;
  V(out) <+ y;
end
endmodule
