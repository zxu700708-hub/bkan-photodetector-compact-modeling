`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // light_voltage
parameter real x1=0.0; // trap_assisted_recomb_A
parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -3.3036241414101095
    + (-0.020768776110053115)*(((x0--1.5)/0.92195444572928875))
    + (0.0010294853151058283)*(((x1-9.9960607086303837e-10)/9.0560912987327889e-11))
    + (-0.0024107388675427151)*(((x2-2488.1644741319419)/98.247983365101405))
    + (0.00048211082548033725)*(((x3-500.26156468032849)/17.257998174885682))
    + (0.0045710345103993511)*(((x4-40.098969033770565)/1.8954448320064825))
    + (-0.0011493837580057536)*(((x5-299.68165354221651)/4.3714147213845527))
  ;
  V(out) <+ y;
end
endmodule
