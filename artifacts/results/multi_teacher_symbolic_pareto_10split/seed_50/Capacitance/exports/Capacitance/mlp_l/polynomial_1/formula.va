`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9264102158753183e-14
    + (2.2155899388057922e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.1503007832666381e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (5.2134703081170907e-19)*(((x2-1.0060461584020687e-09)/9.6497904396972126e-11))
    + (8.6918245681180026e-19)*(((x3-2510.90744987259)/95.674387537647036))
    + (1.2302701785312662e-18)*(((x4-498.15210021645743)/18.812731560420712))
    + (1.3810075471281613e-15)*(((x5-39.956241521741887)/1.916960229174612))
    + (1.0495783522518073e-16)*(((x6-299.66800361756378)/4.7428253317239939))
  ;
  V(out) <+ y;
end
endmodule
