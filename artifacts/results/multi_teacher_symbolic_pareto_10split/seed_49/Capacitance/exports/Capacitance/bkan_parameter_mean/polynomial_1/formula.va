`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9265172625309071e-14
    + (2.2308848347614346e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.0746688692362806e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (-4.1786719175382433e-19)*(((x2-1.0121035988307531e-09)/9.9180046100034365e-11))
    + (3.3956326584501097e-19)*(((x3-2492.6527389352837)/93.523395336008221))
    + (-4.4424234147556273e-19)*(((x4-499.65298500334421)/19.478443351568398))
    + (1.4125306676274683e-15)*(((x5-39.940393007693778)/1.9239540683366856))
    + (9.6511216318136978e-17)*(((x6-299.76390967124678)/4.7184642027229184))
  ;
  V(out) <+ y;
end
endmodule
