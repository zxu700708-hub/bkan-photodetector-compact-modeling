`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9263533536739566e-14
    + (2.2108696390296992e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.227631213581632e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (3.4500350125403812e-18)*(((x2-1.0121035988307531e-09)/9.9180046100034365e-11))
    + (7.9398231251774278e-18)*(((x3-2492.6527389352837)/93.523395336008221))
    + (-2.767607242692225e-18)*(((x4-499.65298500334421)/19.478443351568398))
    + (1.3840496628527492e-15)*(((x5-39.940393007693778)/1.9239540683366856))
    + (1.1142768236162294e-16)*(((x6-299.76390967124678)/4.7184642027229184))
  ;
  V(out) <+ y;
end
endmodule
