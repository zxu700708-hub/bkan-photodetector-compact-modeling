`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3027845270276721
    + (-2.2455671401954365)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.0090953449371554609)*(((x1-39.820513657873825)/1.8846447573976213))
    + (0.014482542689721887)*(((x2-299.98505784889954)/4.337404398424443))
  ;
  V(out) <+ y;
end
endmodule
