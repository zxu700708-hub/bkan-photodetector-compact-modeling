`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3033875667459358
    + (-2.2407795239235466)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.0078635744660764586)*(((x1-39.820513657873825)/1.8846447573976213))
    + (0.0036254042716511686)*(((x2-299.98505784889954)/4.337404398424443))
  ;
  V(out) <+ y;
end
endmodule
