`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // light_voltage
parameter real x1=0.0; // trap_assisted_recomb_A
parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -3.3046480506085434
    + (-0.020686798120403964)*(((x0--1.5)/0.92195444572928875))
    + (0.00084726931488254365)*(((x1-1.0019761524212543e-09)/9.8639848308736747e-11))
    + (-0.0025767592144842525)*(((x2-2495.1227252438066)/95.775736394734452))
    + (0.00047455931338324903)*(((x3-499.76941637907828)/16.703237062910098))
    + (0.0046814591303949073)*(((x4-39.963023633262701)/1.9659119393152182))
    + (-0.0012321175351620777)*(((x5-299.95376505348111)/4.7078246648959299))
  ;
  V(out) <+ y;
end
endmodule
