`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9297121943713714e-14
    + (2.2356912111610838e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.0713472012217021e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (2.9548717438362093e-19)*(((x2-1.0017157249623521e-09)/1.0111972065131941e-10))
    + (-5.7543007895992733e-19)*(((x3-2502.1952245679067)/99.388778769720815))
    + (1.3459550525520847e-18)*(((x4-498.97120352174534)/19.353332511688695))
    + (1.4046787977339671e-15)*(((x5-39.985109292934979)/1.9192766416162574))
    + (8.8926178866712459e-17)*(((x6-299.76021037574446)/4.898973693573879))
  ;
  V(out) <+ y;
end
endmodule
