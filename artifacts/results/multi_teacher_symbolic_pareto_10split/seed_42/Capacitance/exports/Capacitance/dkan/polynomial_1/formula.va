`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9268972677324165e-14
    + (2.2131314175613133e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.134078370696494e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (3.6506132499957365e-18)*(((x2-1.0017157249623521e-09)/1.0111972065131941e-10))
    + (5.2154938349145918e-18)*(((x3-2502.1952245679067)/99.388778769720815))
    + (2.8843868210632255e-18)*(((x4-498.97120352174534)/19.353332511688695))
    + (1.3913375994649142e-15)*(((x5-39.985109292934979)/1.9192766416162574))
    + (1.1016040293005939e-16)*(((x6-299.76021037574446)/4.898973693573879))
  ;
  V(out) <+ y;
end
endmodule
