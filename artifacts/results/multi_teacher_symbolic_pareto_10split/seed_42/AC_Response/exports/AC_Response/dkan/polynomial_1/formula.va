`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3106122503241338
    + (-2.2527960596934533)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.018497729055354649)*(((x1-39.925718488841866)/1.8210226921879977))
    + (0.012209379405640774)*(((x2-299.49641276280852)/4.4611859931360831))
  ;
  V(out) <+ y;
end
endmodule
