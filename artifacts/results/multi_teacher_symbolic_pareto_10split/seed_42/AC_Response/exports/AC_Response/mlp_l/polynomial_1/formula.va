`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.296714279186594
    + (-2.2397727282822109)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.012924827706499097)*(((x1-39.925718488841866)/1.8210226921879977))
    + (0.019406097525265419)*(((x2-299.49641276280852)/4.4611859931360831))
  ;
  V(out) <+ y;
end
endmodule
