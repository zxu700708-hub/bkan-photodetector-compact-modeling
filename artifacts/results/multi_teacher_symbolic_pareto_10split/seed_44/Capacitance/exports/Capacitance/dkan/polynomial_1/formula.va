`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9238328796487273e-14
    + (2.213392151561922e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.2515743768035501e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (2.7614556981974129e-18)*(((x2-1.0065367652866273e-09)/9.9835194695056235e-11))
    + (1.3086155786992168e-18)*(((x3-2501.1344166223621)/98.429099869903155))
    + (1.2161535417232156e-18)*(((x4-498.28741183064511)/18.518143862123068))
    + (1.3192582075234473e-15)*(((x5-39.9227126680289)/1.8351742702432186))
    + (1.055190330841517e-16)*(((x6-299.70257248368898)/5.1263518095618394))
  ;
  V(out) <+ y;
end
endmodule
