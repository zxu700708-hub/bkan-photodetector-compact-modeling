`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9245627413229948e-14
    + (2.2146893262516231e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.1905210446172558e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (4.9457491708740532e-19)*(((x2-1.0065367652866273e-09)/9.9835194695056235e-11))
    + (-4.5252817500287789e-18)*(((x3-2501.1344166223621)/98.429099869903155))
    + (-1.1678809302218111e-18)*(((x4-498.28741183064511)/18.518143862123068))
    + (1.316931415779152e-15)*(((x5-39.9227126680289)/1.8351742702432186))
    + (1.1152595005868023e-16)*(((x6-299.70257248368898)/5.1263518095618394))
  ;
  V(out) <+ y;
end
endmodule
