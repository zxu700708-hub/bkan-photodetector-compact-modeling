`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // light_voltage
parameter real x1=0.0; // trap_assisted_recomb_A
parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -3.3048587191443031
    + (-0.020836291550280488)*(((x0--1.5)/0.92195444572928875))
    + (0.000845132498224452)*(((x1-1.0005658730087512e-09)/9.5696261100871919e-11))
    + (-0.002267195787483172)*(((x2-2506.9688248678749)/98.405680440975573))
    + (0.00015901025847935997)*(((x3-497.61225581413333)/17.665383028101015))
    + (0.004657650639460666)*(((x4-39.991363870852112)/1.9157460346544224))
    + (-0.0014688517028493171)*(((x5-299.64674381453239)/4.8022935229742441))
  ;
  V(out) <+ y;
end
endmodule
