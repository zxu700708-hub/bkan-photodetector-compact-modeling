`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // light_voltage
parameter real x1=0.0; // trap_assisted_recomb_A
parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -3.3047067763713689
    + (-0.020775808051626501)*(((x0--1.5)/0.92195444572928875))
    + (0.00085021044062176185)*(((x1-1.0005658730087512e-09)/9.5696261100871919e-11))
    + (-0.0023926303596178856)*(((x2-2506.9688248678749)/98.405680440975573))
    + (6.613258798611067e-05)*(((x3-497.61225581413333)/17.665383028101015))
    + (0.0045646891716759948)*(((x4-39.991363870852112)/1.9157460346544224))
    + (-0.0015391322739063385)*(((x5-299.64674381453239)/4.8022935229742441))
  ;
  V(out) <+ y;
end
endmodule
