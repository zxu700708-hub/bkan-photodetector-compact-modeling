`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // light_voltage
parameter real x1=0.0; // trap_assisted_recomb_A
parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -3.3046613857150078
    + (-0.020772760523929307)*(((x0--1.5)/0.92195444572928875))
    + (0.0008680830096884888)*(((x1-1.0005658730087512e-09)/9.5696261100871919e-11))
    + (-0.0023294259068273064)*(((x2-2506.9688248678749)/98.405680440975573))
    + (8.8687830360633822e-05)*(((x3-497.61225581413333)/17.665383028101015))
    + (0.0046152574325224625)*(((x4-39.991363870852112)/1.9157460346544224))
    + (-0.0013849465648044102)*(((x5-299.64674381453239)/4.8022935229742441))
  ;
  V(out) <+ y;
end
endmodule
