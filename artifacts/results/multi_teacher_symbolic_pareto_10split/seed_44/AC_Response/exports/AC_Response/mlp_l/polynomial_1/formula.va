`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.2990114288916295
    + (-2.2438488021385146)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.0030316764910534757)*(((x1-39.929647199531161)/1.8372106352843447))
    + (0.0087580679861572301)*(((x2-299.6525584728368)/4.8470246928018863))
  ;
  V(out) <+ y;
end
endmodule
