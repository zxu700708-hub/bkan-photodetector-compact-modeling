`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3093163068727112
    + (-2.2551049315940968)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.013925769475528951)*(((x1-39.929647199531161)/1.8372106352843447))
    + (0.02838094253317695)*(((x2-299.6525584728368)/4.8470246928018863))
  ;
  V(out) <+ y;
end
endmodule
