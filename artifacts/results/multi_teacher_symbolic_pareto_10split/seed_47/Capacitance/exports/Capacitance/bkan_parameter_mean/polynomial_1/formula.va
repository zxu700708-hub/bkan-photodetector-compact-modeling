`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9142099041375991e-14
    + (2.2229070598115725e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.1323721390623971e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (-4.095507981988566e-19)*(((x2-1.0072867204898861e-09)/9.4608249864892579e-11))
    + (1.2674485018403913e-19)*(((x3-2496.786638665224)/96.576261578135075))
    + (9.0948339047200759e-19)*(((x4-501.00418651997973)/17.4580441155885))
    + (1.4311512388090074e-15)*(((x5-39.776638924733888)/1.9494596928234196))
    + (9.8503016581365027e-17)*(((x6-299.8163318928755)/4.8983217005633213))
  ;
  V(out) <+ y;
end
endmodule
