`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3028787551345404
    + (-2.2474706194970526)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.014061579679215713)*(((x1-40.001894304645418)/1.9567889273980634))
    + (0.017544498041087157)*(((x2-299.69654214366005)/4.3720130017535936))
  ;
  V(out) <+ y;
end
endmodule
