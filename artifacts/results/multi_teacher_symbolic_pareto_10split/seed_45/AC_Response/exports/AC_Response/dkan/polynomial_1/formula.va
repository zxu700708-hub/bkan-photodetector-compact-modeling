`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3110762467341761
    + (-2.2475981840168333)*(((x0-8.3277898747714616)/11.881455540915038))
    + (0.0080190030056775021)*(((x1-40.022715384318793)/1.754539833809251))
    + (0.010772332223898892)*(((x2-299.3511021829662)/4.8187427782282812))
  ;
  V(out) <+ y;
end
endmodule
