`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9242584716381342e-14
    + (2.2144776375568454e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.1813927706886593e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (3.1144592289218898e-18)*(((x2-1.0059572539195863e-09)/9.4592856906498549e-11))
    + (-5.7127189091206551e-19)*(((x3-2500.5794002599973)/94.553569606420623))
    + (-1.1990755829224225e-20)*(((x4-499.65822913585464)/17.912284843435192))
    + (1.3916887011899197e-15)*(((x5-39.925465535502276)/1.9326606220319453))
    + (1.0214535369187734e-16)*(((x6-299.41652592051338)/4.7984008949544457))
  ;
  V(out) <+ y;
end
endmodule
