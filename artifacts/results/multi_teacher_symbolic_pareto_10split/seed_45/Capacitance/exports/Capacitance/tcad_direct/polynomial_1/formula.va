`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9242363789985134e-14
    + (2.2250594541908129e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.2061131087981578e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (-1.0899295298311886e-19)*(((x2-1.0059572539195863e-09)/9.4592856906498549e-11))
    + (4.8287262674131976e-19)*(((x3-2500.5794002599973)/94.553569606420623))
    + (-9.5178844937065538e-20)*(((x4-499.65822913585464)/17.912284843435192))
    + (1.4154998842124912e-15)*(((x5-39.925465535502276)/1.9326606220319453))
    + (1.091524269652606e-16)*(((x6-299.41652592051338)/4.7984008949544457))
  ;
  V(out) <+ y;
end
endmodule
