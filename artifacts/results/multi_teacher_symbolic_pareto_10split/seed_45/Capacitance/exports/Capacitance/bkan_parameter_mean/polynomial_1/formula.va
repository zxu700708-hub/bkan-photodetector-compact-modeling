`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9239865168262576e-14
    + (2.2186043866722323e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.2066612707361235e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (-3.4936194171398825e-19)*(((x2-1.0059572539195863e-09)/9.4592856906498549e-11))
    + (8.2884296392764017e-19)*(((x3-2500.5794002599973)/94.553569606420623))
    + (3.0544591753689034e-19)*(((x4-499.65822913585464)/17.912284843435192))
    + (1.414289482006155e-15)*(((x5-39.925465535502276)/1.9326606220319453))
    + (1.0193520613469807e-16)*(((x6-299.41652592051338)/4.7984008949544457))
  ;
  V(out) <+ y;
end
endmodule
