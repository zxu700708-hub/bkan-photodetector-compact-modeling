`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // bias_v
parameter real x1=0.0; // log_frequency_ghz
parameter real x2=0.0; // trap_assisted_recomb_A
parameter real x3=0.0; // ge_sio2_recomb_velocity
parameter real x4=0.0; // ge_si_recomb_velocity
parameter real x5=0.0; // active_layer_length
parameter real x6=0.0; // simulation_temperature
real y;
analog begin
  y = 2.9208882536063886e-14
    + (2.2100088402681441e-15)*(((x0--1.5)/0.92195444572928875))
    + (-4.1449415575936608e-16)*(((x1-0.19604119982655921)/0.71475520981330376))
    + (1.4510052324783321e-18)*(((x2-9.9787383664924926e-10)/9.755670364835263e-11))
    + (2.6046383318183432e-19)*(((x3-2514.3534328885385)/103.12963682602945))
    + (-2.5087310419663338e-18)*(((x4-500.04582580114516)/18.587130940557216))
    + (1.3541937735034105e-15)*(((x5-39.8911020987616)/1.89004086008762))
    + (1.0768584131854954e-16)*(((x6-299.28312271861068)/5.0355204136510787))
  ;
  V(out) <+ y;
end
endmodule
