`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // frequency_ghz
parameter real x1=0.0; // active_layer_length
parameter real x2=0.0; // simulation_temperature
real y;
analog begin
  y = -2.3076861972337239
    + (-2.2562766901540994)*(((x0-8.3277898747714616)/11.88145554091504))
    + (0.010977658881880823)*(((x1-40.032923533168265)/1.7857913676032817))
    + (0.024741629345516915)*(((x2-299.3608225838347)/4.7615435936653459))
  ;
  V(out) <+ y;
end
endmodule
