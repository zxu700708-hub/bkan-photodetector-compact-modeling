`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // light_voltage
parameter real x1=0.0; // trap_assisted_recomb_A
parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -3.3051701583541355
    + (-0.021139694419035172)*(((x0--1.5)/0.92195444572928875))
    + (0.00091323962345451711)*(((x1-1.0025783897495377e-09)/9.8772119291203222e-11))
    + (-0.0020756818458652244)*(((x2-2507.9273377570862)/96.387320503811637))
    + (0.00011626679244956485)*(((x3-499.95386921116199)/18.056351303231796))
    + (0.0042574055852666751)*(((x4-39.808459272796568)/1.8786219433439726))
    + (-0.00097054956946185204)*(((x5-299.59196653794334)/4.8072420583811404))
  ;
  V(out) <+ y;
end
endmodule
