`include "constants.vams"
`include "disciplines.vams"
module poly3_export(out);
output out; electrical out;
parameter real x0=0.0; // light_voltage
parameter real x1=0.0; // trap_assisted_recomb_A
parameter real x2=0.0; // ge_sio2_recomb_velocity
parameter real x3=0.0; // ge_si_recomb_velocity
parameter real x4=0.0; // active_layer_length
parameter real x5=0.0; // simulation_temperature
real y;
analog begin
  y = -3.3053231700681724
    + (-0.020706536078962171)*(((x0--1.5)/0.92195444572928875))
    + (0.00069769124785447182)*(((x1-1.0025783897495377e-09)/9.8772119291203222e-11))
    + (-0.0020831807257106396)*(((x2-2507.9273377570862)/96.387320503811637))
    + (0.00012631357820208831)*(((x3-499.95386921116199)/18.056351303231796))
    + (0.0040624483708612009)*(((x4-39.808459272796568)/1.8786219433439726))
    + (-0.0011945538316584564)*(((x5-299.59196653794334)/4.8072420583811404))
  ;
  V(out) <+ y;
end
endmodule
